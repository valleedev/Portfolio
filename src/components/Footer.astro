---
const currentYear = new Date().getFullYear()
---

<footer
  class="relative z-[1] mx-auto mt-20 flex w-full max-w-[1080px] flex-wrap items-center justify-between gap-5 border-t border-[var(--line)] px-6 pb-10 pt-7"
>
  <span class="text-sm text-[var(--muted)]">
    © {currentYear}
    <a href="https://portfolio.jsvb.dev/" class="hover:underline"
      >Johan Sebastian Valle B.</a
    >
  </span>
  <div class="flex gap-6 text-sm">
    <a
      href="https://linkedin.com/in/sebasvalle"
      target="_blank"
      rel="noopener"
      class="text-[var(--muted)] hover:text-[var(--fg)]">LinkedIn</a
    >
    <a
      href="https://github.com/valleedev"
      target="_blank"
      rel="noopener"
      class="text-[var(--muted)] hover:text-[var(--fg)]">GitHub</a
    >
    <a
      href="mailto:vallebarbaranj@gmail.com"
      class="text-[var(--muted)] hover:text-[var(--fg)]">Contacto</a
    >
  </div>
</footer>
