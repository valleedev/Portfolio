---
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import ReactIcon from "./icons/React.astro"
import NodeJSIcon from "./icons/NodeJS.astro"
import MySQLIcon from "./icons/MySQL.astro"
import NestJSIcon from "./icons/NestJS.astro"
import PHPIcon from "./icons/PHP.astro"
import TypeScriptIcon from "./icons/TypeScript.astro"
import GitIcon from "./icons/Git.astro"
import DockerIcon from "./icons/Docker.astro"
import SupabaseIcon from "./icons/Supabase.astro"
import ClerkIcon from "./icons/Clerk.astro"

const TECH_CATEGORIES = [
  {
    name: "Frontend",
    technologies: [
      { name: "React", icon: ReactIcon },
      { name: "Next.js", icon: NextJS },
      { name: "TypeScript", icon: TypeScriptIcon },
      { name: "Tailwind", icon: Tailwind },
    ],
  },
  {
    name: "Backend",
    technologies: [
      { name: "Node.js", icon: NodeJSIcon },
      { name: "NestJS", icon: NestJSIcon },
      { name: "PHP", icon: PHPIcon },
    ],
  },
  {
    name: "Datos y herramientas",
    technologies: [
      { name: "MySQL", icon: MySQLIcon },
      { name: "Git", icon: GitIcon },
      { name: "Docker", icon: DockerIcon },
      { name: "Supabase", icon: SupabaseIcon },
      { name: "Clerk", icon: ClerkIcon },
    ],
  },
]
---

<div class="flex items-baseline gap-3.5">
  <span class="font-mono text-xs text-[var(--accent)]">01</span>
  <h2 class="m-0 text-[34px] font-semibold tracking-[-0.03em] text-[var(--fg)]">
    Stack técnico
  </h2>
</div>
<p class="mt-3 max-w-[60ch] text-base text-[var(--muted)]">
  Las herramientas con las que trabajo a diario, agrupadas por dónde las
  uso.
</p>

<div class="mt-9 grid grid-cols-1 gap-[18px] md:grid-cols-3">
  {
    TECH_CATEGORIES.map((category) => (
      <div class="rounded-[18px] border border-[var(--line)] bg-[var(--card)] p-6 transition duration-300 hover:-translate-y-1 hover:border-[var(--line2)]">
        <h3 class="mb-[18px] font-mono text-xs font-medium uppercase tracking-[0.08em] text-[var(--muted)]">
          {category.name}
        </h3>
        <div class="flex flex-wrap gap-2">
          {category.technologies.map((tech) => (
            <span class="inline-flex items-center gap-2 rounded-[10px] border border-[var(--line)] px-[13px] py-2 text-sm text-[var(--fg)] transition hover:-translate-y-0.5 hover:border-[var(--accent)]">
              <tech.icon class="size-[17px]" />
              {tech.name}
            </span>
          ))}
        </div>
      </div>
    ))
  }
</div>
