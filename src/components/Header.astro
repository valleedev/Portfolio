---
import ThemeToggle from "./ThemeToggle.astro"

const navItems = [
  { title: "Stack", label: "stack", url: "/#stack" },
  { title: "Proyectos", label: "proyectos", url: "/#proyectos" },
  { title: "Experiencia", label: "experiencia", url: "/#experiencia" },
  { title: "Sobre mí", label: "sobre-mi", url: "/#sobre-mi" },
]
---

<header class="fixed top-0 left-0 right-0 z-40 flex justify-center p-3.5">
  <nav
    id="header-nav"
    class="flex max-w-full items-center gap-1.5 rounded-full border border-[var(--line)] bg-[color-mix(in_srgb,var(--bg)_72%,transparent)] py-1.5 pl-4 pr-1.5 shadow-[0_8px_30px_rgba(0,0,0,.18)] backdrop-blur-[18px]"
  >
    <a
      href="/#top"
      class="mr-2.5 font-mono text-[13px] tracking-[0.06em] text-[var(--fg)]"
    >
      JSVB
    </a>
    <div class="flex items-center gap-0.5">
      {
        navItems.map((link) => (
          <a
            class="nav-link block rounded-full px-3 py-2 text-sm font-medium text-[var(--muted)] transition hover:bg-[var(--bg2)] hover:text-[var(--fg)]"
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </div>
    <div class="mx-1.5 h-5 w-px bg-[var(--line)]"></div>
    <ThemeToggle />
    <a
      href="/Johan Sebastian Valle B. Curriculum.pdf"
      download
      class="inline-flex items-center gap-2 rounded-full bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-[var(--accent-ink)] transition hover:-translate-y-px hover:brightness-[1.06]"
    >
      Descargar CV
    </a>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("main section[id]")
    const navItems = document.querySelectorAll("header nav a.nav-link")

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-[var(--fg)]", "bg-[var(--bg2)]")
            } else {
              item.classList.remove("text-[var(--fg)]", "bg-[var(--bg2)]")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>
