---
interface Props {
  title: string
  company: string
  description: string
  dateLabel: string
  typeLabel: string
  current?: boolean
  tags?: string[]
}

const { title, company, description, dateLabel, typeLabel, current, tags } =
  Astro.props
---

<li class="relative grid grid-cols-[170px_1fr] gap-9 pb-11">
  <div class="pt-0.5 text-right">
    <div
      class:list={[
        "font-mono text-[13px]",
        current ? "text-[var(--accent)]" : "text-[var(--muted)]",
      ]}
    >
      {dateLabel}
    </div>
    <div class="mt-1.5 text-xs text-[var(--muted)]">{typeLabel}</div>
  </div>
  <div class="relative border-l border-[var(--line)] pb-1.5 pl-[34px]">
    <span
      class:list={[
        "absolute top-1.5 rounded-full",
        current
          ? "-left-[6.5px] h-3 w-3 bg-[var(--accent)] shadow-[0_0_0_5px_var(--bg),0_0_0_6px_var(--line)]"
          : "-left-[5px] top-2 h-[9px] w-[9px] bg-[var(--line2)] shadow-[0_0_0_5px_var(--bg)]",
      ]}
    />
    <h3 class="m-0 text-xl font-semibold text-[var(--fg)]">{title}</h3>
    <div class="mt-1 text-[15px] text-[var(--muted)]">{company}</div>
    <p class="mt-3.5 max-w-[62ch] text-[15px] leading-[1.65] text-[var(--muted)]">
      {description}
    </p>
    {
      tags && tags.length > 0 && (
        <div class="mt-3.5 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-[7px] border border-[var(--line)] px-[10px] py-[5px] font-mono text-[11px] text-[var(--muted)]">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</li>
