---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCE = [
  {
    date: "Actualmente...",
    title: "Desarrollador Full Stack",
    company: "Fábrica de Software — Centro de Diseño e Innovación Tecnológica Industrial",
    description:
      "Desarrollo del módulo de portafolio del aprendiz y gestión de archivos privados en el aplicativo Zajuna. Implemento scripts backend para procesos internos, integro servicios y colaboro en la mejora continua de la plataforma. Stack: Node.js, React, bases de datos relacionales.",
  },
  {
    date: "2022 - 2023",
    title: "Líder de Desarrollo",
    company: "Raptor Technologies",
    description:
      "Lideré el equipo de desarrollo de una aplicación web para una constructora regional. Definí la arquitectura técnica, distribuí tareas, revisé código y coordiné entregas con el cliente. La aplicación optimizó la gestión de proyectos constructivos, reduciendo el tiempo de seguimiento en un 40%.",
  },
  {
    date: "2023 - 2024",
    title: "Desarrollador Freelance",
    company: "Freelance",
    description:
      "Desarrollé soluciones web a medida para clientes en distintos sectores: sistemas de ventas, landing pages y automatizaciones. Gestioné el ciclo completo: levantamiento de requerimientos, desarrollo, despliegue y soporte.",
  },
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
